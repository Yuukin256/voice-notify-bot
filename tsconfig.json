{
  "compilerOptions": {
    "outDir": "./dist",
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "lib": ["ESNext"],
    "baseUrl": "./src/"
  },
  "include": ["src/**/*.ts"]
}
